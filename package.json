{
  "name": "plan-my-today",
  "version": "0.2.3",
  "description": "An MCP server for compiling To-Dos from multiple sources",
  "license": "Elastic-2.0",
  "author": "Keycard AI",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "tsc --noEmit && jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "tsc --noEmit && jest tests/server-integration.test.ts --forceExit",
    "start": "nodemon --ignore data/ --exec ts-node -r tsconfig-paths/register src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsup",
    "build:check": "tsc --noEmit",
    "build:all": "npm run build && cd ui && npm install && npm run build",
    "dev": "nodemon --ignore data/ --exec ts-node -r tsconfig-paths/register src/index.ts",
    "plan-my-today": "bash scripts/start.sh",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "release": "release-it",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "keycard",
    "authentication",
    "oauth"
  ],
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@keycardai/mcp": "^0.5.0",
    "@keycardai/oauth": "^0.26.3",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "async-lock": "^1.4.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@release-it/conventional-changelog": "^10.0.5",
    "@types/async-lock": "^1.4.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.0.15",
    "@types/supertest": "^7.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "release-it": "^19.2.4",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
