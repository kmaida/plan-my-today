{
  "name": "todo-mcp-server",
  "version": "0.2.1",
  "description": "An MCP server for compiling To-Dos from multiple sources",
  "license": "Apache-2.0",
  "author": "Keycard AI",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/server-integration.test.ts --forceExit",
    "start": "nodemon --ignore data/ --exec ts-node -r tsconfig-paths/register src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc",
    "build:all": "npm run build && cd ui && npm install && npm run build",
    "dev": "nodemon --ignore data/ --exec ts-node -r tsconfig-paths/register src/index.ts",
    "dashboard": "bash scripts/start.sh",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/"
  },
  "keywords": [
    "mcp",
    "keycard",
    "authentication",
    "oauth"
  ],
  "dependencies": {
    "@keycardlabs/mcp-oauth": "file:./keycardlabs-mcp-oauth-0.0.0.tgz",
    "@modelcontextprotocol/sdk": "^1.16.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.15",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "nodemon": "^3.1.10",
    "open": "^11.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "winston": "^3.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2"
  }
}
