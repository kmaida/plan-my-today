{
  "auto_merge": false,
  "max_lines": 300,
  "allow": ["src/*", "tests/*", "ui/src/*", "docs/*", "README.md", "CHANGELOG.md"],
  "deny": [
    "src/server.ts", "src/services/keycard-client.ts", "src/config.ts", "ui/src/auth/*",
    "keycard.toml", "*.env*", "*secret*",
    "*.yml", "*.yaml", ".github/*", ".factory/*", ".claude/*", "CLAUDE.md", ".husky/*",
    "package.json", "package-lock.json", "ui/package.json", "ui/package-lock.json",
    "tsconfig*", "tsup.config.ts", "biome.json", "jest.config.js", "scripts/*",
    "tests/helpers/*", "tests/setup*", "*__mocks__*"
  ],
  "tests": ["tests/*", "*__tests__*", "*.test.*", "*.spec.*"],
  "checks": ["npm test", "npm run build", "npm run check"],
  "launch": "npm run dev"
}
