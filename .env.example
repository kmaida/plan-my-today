# Plan My Today MCP Server Configuration

# Required: Your Keycard zone URL (Retrieve from Zone Settings)
# Format: <scheme>://<zone-id>.<domain> — domain depends on Keycard env:
#   production = keycard.cloud (https)
#   staging    = keycard-stage.cloud (https)
#   dev        = keycard-dev.cloud (https)
#   localdev   = localdev.keycard.sh (http)
KEYCARD_URL=https://your-zone-id.keycard.cloud

# Keycard application credentials for token exchange
KEYCARD_CLIENT_ID=[KeycardApplicationClientId]
KEYCARD_CLIENT_SECRET=[KeycardApplicationClientSecret]

# Slack custom emoji name (without colons) to track as "saved" messages
# Create this emoji in your Slack workspace first: Customize Slack → Add Custom Emoji
# Example: "my-todo-reminder" will track messages saved with :my-todo-reminder:
# Defaults to "mcp-todo-reminder" if not set
SLACK_EMOJI_NAME=mcp-todo-reminder

# Calendar prep block prefix (optional — case-insensitive match on event titles)
# Used to identify meeting-prep focus blocks and link them to the next meeting's context
# Default: [Prep]
CALENDAR_PREP_PREFIX=[prep]

# Google Drive folder ID for Granola meeting notes (required for meeting notes)
# Find this in the Google Drive URL: https://drive.google.com/drive/folders/<FOLDER_ID>
# See docs/granola-setup.md for full setup instructions
MEETING_NOTES_FOLDER_ID=

# User identity (optional - filters meeting notes to your action items only)
# Comma-separated name variants for matching, e.g. first name, full name, username
USER_DISPLAY_NAME=Kim,Kim Maida,kimmaida

# Anthropic API for the Todaygent chatbot (optional — only needed if using the chat UI)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Model: defaults to claude-sonnet-4-6. Set to claude-opus-4-6 to enable
# automatic context compaction (intelligent summarization of long conversations).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# GitHub org repos to watch for incoming PRs/issues from coworkers (optional)
# Comma-separated owner/repo pairs, e.g. "myorg/backend,myorg/frontend"
# Only needed for repos where you won't always be explicitly review-requested
# ORG_GITHUB_REPOS=

# ROIbot A2A agent endpoint for agent-to-agent task delegation (optional).
# The Keycard resource URI for ROIbot's /api/agent endpoint on the dashboard.
# Used both as the token-exchange `resource` and as the A2A endpoint URL.
# Replaces the older ROIBOT_MCP_ENDPOINT (architecture moved from MCP-proxy
# to A2A delegation in May 2026 — see CHANGELOG).
# Local dev: http://localhost:3000/api/agent
# Production: https://event-roi.fly.dev/api/agent
# ROIBOT_AGENT_ENDPOINT=http://localhost:3000/api/agent

# Server configuration
PORT=9005
HOST=localhost
