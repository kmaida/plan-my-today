# To Do MCP Server Configuration

# Required: Your Keycard STS issuer URL (Retrieve from Zone Settings)
KEYCARD_STS_ISSUER_URL=https://your-zone-id.keycard.cloud

# Keycard application credentials for token exchange
KEYCARD_CLIENT_ID=[KeycardApplicationClientId]
KEYCARD_CLIENT_SECRET=[KeycardApplicationClientSecret]

# Slack Integration (optional - single-user deployment only)
# Requires user token (xoxp-) with scopes: search:read, reactions:read, reactions:write
SLACK_USER_TOKEN=xoxp-your-user-token-here

# Slack custom emoji name (without colons) to track as "saved" messages
# Create this emoji in your Slack workspace first: Customize Slack → Add Custom Emoji
# Example: "my-todo-reminder" will track messages saved with :my-todo-reminder:
# Defaults to "mcp-todo-reminder" if not set
SLACK_EMOJI_NAME=mcp-todo-reminder

# User identity (optional - filters meeting notes to your action items only)
# Comma-separated name variants for matching, e.g. first name, full name, username
USER_DISPLAY_NAME=Kim,Kim Maida,kimmaida

# Server configuration
PORT=9005
HOST=localhost
LOCAL_TUNNEL=https://unpreferable-cropless-dede.ngrok-free.dev

# Optional: Observability settings
OTEL_SERVICE_NAME=todo-mcp-server
OTEL_SERVICE_VERSION=0.1.0
OTEL_ENVIRONMENT=development
ENABLE_OTEL=true

# Logging Configuration
LOG_LEVEL=INFO

# OpenTelemetry Endpoints (optional - only needed for production)
# Comment out for development to use clean console logging instead
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces